{
    "base_model_name": "D:/models/diffusers/anima/anima-base-v1.0",
    "batch_size": 2,
    "gradient_accumulation_steps": 2,
    "learning_rate": 2e-4,
    "learning_rate_scheduler": "COSINE_WITH_HARD_RESTARTS",
    "learning_rate_warmup_steps": 200,
    "learning_rate_cycles": 2.0,
    "learning_rate_min_factor": 0.05,
    "model_type": "ANIMA",
    "training_method": "LORA",
    "resolution": "512",
    "epochs": 100,
    "backup_after": 10,
    "output_model_destination": "models/anima_lora.safetensors",
    "output_model_format": "SAFETENSORS",
    "transformer": {
        "train": true,
        "weight_dtype": "FLOAT_8"
    },
    "text_encoder": {
        "train": false,
        "weight_dtype": "BFLOAT_16"
    },
    "vae": {
        "weight_dtype": "FLOAT_32"
    },
    "train_dtype": "BFLOAT_16",
    "weight_dtype": "BFLOAT_16",
    "output_dtype": "BFLOAT_16",
    "lora_rank": 32,
    "lora_alpha": 1.0,
    "lora_weight_dtype": "BFLOAT_16",
    "layer_filter": "^(?=.*attn)(?!.*norm).*,^(?=.*ff\\.net).*",
    "layer_filter_preset": "attn-mlp",
    "layer_filter_regex": true,
    "quantization": {
        "layer_filter": "transformer_blocks",
        "layer_filter_preset": "blocks"
    },
    "dataloader_threads": 2,
    "timestep_distribution": "LOGIT_NORMAL",
    "timestep_shift": 3.0,
    "dynamic_timestep_shifting": false,
    "compile": true,
    "latent_caching": true,
    "optimizer": {
        "optimizer": "CAME_8BIT"
    },
    "optimizer_defaults": {
        "CAME_8BIT": {
            "optimizer": "CAME_8BIT",
            "beta1": 0.9,
            "beta2": 0.999,
            "beta3": 0.9999,
            "eps": 1e-30,
            "eps2": 1e-16,
            "weight_decay": 1e-3,
            "stochastic_rounding": true,
            "fused_back_pass": true,
            "min_8bit_size": 16384,
            "quant_block_size": 2048
        }
    }
}
